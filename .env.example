# Nastavuje se ve Vercelu (Settings → Environment Variables), nikdy do repozitáře.
# Klíč z resend.com → API Keys (oprávnění „Sending access").
RESEND_API_KEY=
# Odesílatel na doméně ověřené v Resendu, např.: Poptávky <poptavky@vase-domena.cz>
MAIL_FROM=
# Kam poptávky chodí (víc adres oddělte čárkou).
POPTAVKA_KOMU=
# Jen Docker za reverzní proxy: věřit hlavičce x-forwarded-for.
TRUST_PROXY=
